<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ChristieSpecial's Pharm & Med. Lab</title>
<style>
:root{--blue:#1856a5;--blue2:#0d3977;--pink:#ed78a8;--pink2:#fff0f6;--white:#fff;--ink:#17243a;--muted:#64748b;--line:#e6edf5;--soft:#f5f9ff;--shadow:0 16px 40px #17365d12}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:#fff;line-height:1.55}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.top{background:var(--blue2);color:white;text-align:center;padding:8px 15px;font-size:13px}.wrap{max-width:1160px;margin:auto;padding:0 22px}.nav{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:17px 0;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:11px;font-weight:800;color:var(--blue2)}.logo{width:43px;height:43px;border-radius:14px;background:var(--pink2);color:var(--blue);display:grid;place-items:center;font-size:25px}.brand small{display:block;font-size:10px;letter-spacing:1.2px;color:var(--muted);font-weight:700}.links{display:flex;gap:20px;align-items:center;font-size:14px;color:#334155}.links a:hover{color:var(--blue)}.btn{border:0;border-radius:10px;padding:11px 17px;background:var(--blue);color:white;font-weight:700;cursor:pointer;display:inline-block}.btn.pink{background:var(--pink);color:#3a1730}.btn.outline{background:white;border:1px solid #cbd8e8;color:var(--blue)}.hero{margin:34px 0 46px;border-radius:25px;background:linear-gradient(115deg,#f5f9ff 0%,#fff 62%,#fff1f7 100%);padding:56px;display:grid;grid-template-columns:1.3fr .7fr;gap:25px;align-items:center;overflow:hidden}.eyebrow{color:var(--blue);font-size:12px;font-weight:800;letter-spacing:1.7px;text-transform:uppercase}.hero h1{font-size:clamp(34px,5vw,55px);line-height:1.08;letter-spacing:-1.8px;color:var(--blue2);margin:13px 0}.hero p{color:var(--muted);max-width:570px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.hero-art{height:245px;border-radius:50%;background:radial-gradient(circle at 40% 35%,white 0 20%,#dceaff 21% 52%,#f9c8dd 53% 70%,#fceaf2 71%);display:grid;place-items:center;color:var(--blue);font-size:105px;box-shadow:inset 0 0 0 15px #ffffff80}.section{padding:22px 0 38px}.head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:19px}.head h2{margin:5px 0;color:var(--blue2);font-size:28px}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{border:1px solid var(--line);border-radius:17px;padding:22px;background:white;box-shadow:var(--shadow)}.tile{height:47px;width:47px;border-radius:14px;background:var(--pink2);display:grid;place-items:center;font-size:24px}.card h3{margin:13px 0 5px;color:var(--blue2)}.card p{color:var(--muted);font-size:14px}.card a.textlink{font-size:14px;font-weight:750;color:var(--blue)}.products{grid-template-columns:repeat(4,1fr)}.product-img{height:135px;border-radius:12px;background:linear-gradient(140deg,#f3f8ff,#fff0f6);display:grid;place-items:center;font-size:43px;color:var(--blue)}.price{color:var(--blue);font-weight:800;margin:8px 0}.pill{font-size:11px;background:#eef5ff;color:var(--blue);padding:5px 8px;border-radius:20px}.split{display:grid;grid-template-columns:1fr 1fr;gap:18px}.banner{background:var(--blue2);color:white;border-radius:20px;padding:28px}.banner h2{margin:5px 0 10px}.banner p{color:#d7e5fa}.banner .btn{background:var(--pink);color:#3a1730}.formbox{border:1px solid var(--line);border-radius:18px;padding:22px;background:#fff}.field{margin:12px 0}.field label{display:block;font-size:13px;font-weight:700;margin-bottom:5px}.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid #d7e0ec;border-radius:9px;background:white}.field textarea{min-height:90px}.notice{background:#fff5f9;border-left:4px solid var(--pink);padding:15px;border-radius:8px;color:#67445a;font-size:13px;margin:25px 0}.footer{background:#f5f8fc;margin-top:40px;padding:30px 0;color:var(--muted);font-size:13px}.footergrid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:25px}.modal{display:none;position:fixed;inset:0;background:#0b1b33a8;z-index:9;align-items:center;justify-content:center;padding:18px}.modal.show{display:flex}.modalbox{background:white;border-radius:18px;padding:25px;width:min(440px,100%);max-height:90vh;overflow:auto}.close{float:right;border:0;background:#f2f5fa;border-radius:8px;padding:6px 10px;cursor:pointer}.mobilemenu{display:none}@media(max-width:800px){.links{display:none}.mobilemenu{display:inline-block}.hero{padding:30px;grid-template-columns:1fr}.hero-art{height:160px;font-size:75px}.grid{grid-template-columns:1fr 1fr}.products{grid-template-columns:1fr 1fr}.split{grid-template-columns:1fr}.footergrid{grid-template-columns:1fr}}@media(max-width:520px){.wrap{padding:0 15px}.hero{margin:20px 0 30px;padding:23px}.grid,.products{grid-template-columns:1fr}.head{align-items:start;flex-direction:column}.brand{font-size:13px}}
</style></head>
<body>
<div class="top">Pharmacy • Medical Laboratory • Patient Support &nbsp; | &nbsp; Lagos, Nigeria</div>
<header class="wrap"><nav class="nav"><a class="brand" href="#home"><span class="logo">✚</span><span>ChristieSpecial's<small>PHARM & MED. LAB</small></span></a><div class="links"><a href="#home">Home</a><a href="#pharmacy">Pharmacy</a><a href="#laboratory">Laboratory</a><a href="#support">Patient Support</a><a href="#contact">Contact</a></div><div><button class="btn outline" onclick="openModal('login')">Login</button> <button class="btn" onclick="openModal('register')">Register</button><button class="btn outline mobilemenu" onclick="document.getElementById('mobilelinks').hidden=!document.getElementById('mobilelinks').hidden">☰</button></div></nav><div id="mobilelinks" hidden style="padding:12px;display:flex;gap:14px;flex-wrap:wrap"><a href="#pharmacy">Pharmacy</a><a href="#laboratory">Laboratory</a><a href="#support">Patient Support</a><a href="#contact">Contact</a></div></header>
<main class="wrap" id="home">
<section class="hero"><div><span class="eyebrow">Care you can trust</span><h1>Healthcare, pharmacy & diagnostics — connected.</h1><p>Explore pharmacy products, request laboratory services and manage your healthcare needs through one convenient platform.</p><div class="actions"><a class="btn pink" href="#pharmacy">Explore products</a><a class="btn outline" href="#laboratory">Book a lab service</a></div></div><div class="hero-art">✚</div></section>
<section class="section"><div class="head"><div><span class="eyebrow">Our services</span><h2>Care across every step</h2></div></div><div class="grid"><article class="card"><div class="tile">💊</div><h3>Pharmacy</h3><p>Browse medicines and healthcare products. Prescription-only items require pharmacist review.</p><a class="textlink" href="#pharmacy">Browse products →</a></article><article class="card"><div class="tile">🧪</div><h3>Medical laboratory</h3><p>Explore diagnostic services and send a laboratory service request.</p><a class="textlink" href="#laboratory">Explore laboratory →</a></article><article class="card"><div class="tile">🚚</div><h3>Order tracking</h3><p>Follow order processing and delivery updates from your customer account.</p><a class="textlink" href="#tracking">Track an order →</a></article></div></section>
<section class="section" id="pharmacy"><div class="head"><div><span class="eyebrow">Pharmacy catalogue</span><h2>Shop healthcare essentials</h2><p class="muted">Catalogue items and prices are illustrative until the live inventory is connected.</p></div><input aria-label="Search products" placeholder="Search products…" oninput="filterProducts(this.value)" style="padding:10px;border:1px solid #d7e0ec;border-radius:9px"></div><div class="grid products" id="productgrid"><article class="card product" data-name="multivitamin supplements"><div class="product-img">💊</div><span class="pill">Supplements</span><h3>Multivitamin supplements</h3><p>General wellness range</p><div class="price">Price on request</div><button class="btn outline" onclick="alert('Please sign in on the connected customer portal to place an order.')">View product</button></article><article class="card product" data-name="baby care infant"><div class="product-img">🍼</div><span class="pill">Infant care</span><h3>Baby care essentials</h3><p>Selected infant-care products</p><div class="price">Price on request</div><button class="btn outline" onclick="alert('Please sign in on the connected customer portal to place an order.')">View product</button></article><article class="card product" data-name="personal care skin"><div class="product-img">🧴</div><span class="pill">Personal care</span><h3>Personal care products</h3><p>Everyday health and skin care</p><div class="price">Price on request</div><button class="btn outline" onclick="alert('Please sign in on the connected customer portal to place an order.')">View product</button></article><article class="card product" data-name="medical supplies"><div class="product-img">🩺</div><span class="pill">Medical supplies</span><h3>Medical essentials</h3><p>Selected home-care supplies</p><div class="price">Price on request</div><button class="btn outline" onclick="alert('Please sign in on the connected customer portal to place an order.')">View product</button></article></div></section>
<section class="section" id="laboratory"><div class="split"><div class="banner"><span class="eyebrow" style="color:#f6b8d1">Medical laboratory</span><h2>Diagnostic services with professional care.</h2><p>Send a test enquiry and our laboratory team can guide you on service availability, preparation and next steps.</p><a class="btn" href="#labform">Request a laboratory service</a></div><div class="formbox" id="labform"><h3>Laboratory service enquiry</h3><form onsubmit="demoSubmit(event,'Your laboratory enquiry preview has been recorded on this page. Connect the live service before collecting real patient data.')"><div class="field"><label>Full name</label><input required placeholder="Your full name"></div><div class="field"><label>Phone number</label><input required type="tel" placeholder="+234…"></div><div class="field"><label>Test or service required</label><input required placeholder="Enter test name"></div><div class="field"><label>Additional message</label><textarea placeholder="Optional details"></textarea></div><button class="btn pink">Send enquiry</button></form></div></div></section>
<section class="section" id="support"><div class="head"><div><span class="eyebrow">Patient support</span><h2>How can we help you?</h2></div></div><div class="split"><div class="card"><div class="tile">💬</div><h3>General health enquiry</h3><p>Send a non-emergency enquiry for the appropriate healthcare professional to review. Do not use this channel for emergencies.</p><a class="btn" href="#enquiryform">Send an enquiry</a></div><div class="formbox" id="enquiryform"><h3>Contact our care team</h3><form onsubmit="demoSubmit(event,'Your enquiry preview has been recorded on this page. Connect the live service before collecting real patient data.')"><div class="field"><label>Name</label><input required placeholder="Full name"></div><div class="field"><label>Phone</label><input required type="tel" placeholder="Phone number"></div><div class="field"><label>Subject</label><input required placeholder="What do you need help with?"></div><div class="field"><label>Message</label><textarea required placeholder="Write your enquiry"></textarea></div><button class="btn pink">Submit enquiry</button></form></div></div><div class="notice">This website does not provide emergency medical care or replace assessment by a qualified healthcare professional. Do not submit urgent symptoms or sensitive medical records through this preview.</div></section>
<section class="section" id="tracking"><div class="split"><div><span class="eyebrow">Order support</span><h2 style="color:var(--blue2)">Track your order</h2><p class="muted">Sign in to the connected customer portal to view order status, payment confirmation and delivery updates.</p><button class="btn" onclick="openModal('login')">Customer login</button></div><div class="card"><h3>Staff & administration</h3><p>Authorised staff access their assigned workspace after account approval. CEO access controls staff permissions.</p><button class="btn outline" onclick="openModal('login')">Staff / CEO login</button></div></div></section>
<section class="section" id="contact"><div class="head"><div><span class="eyebrow">Get in touch</span><h2>We are here to help</h2></div></div><div class="grid"><div class="card"><div class="tile">☎</div><h3>Call us</h3><p>07063184641<br>09161707477</p></div><div class="card"><div class="tile">✉</div><h3>Email</h3><p>onalochristianah@gmail.com</p></div><div class="card"><div class="tile">☏</div><h3>WhatsApp</h3><p>Chat with our support team.</p><a class="btn" target="_blank" rel="noopener" href="https://wa.me/2347063184641">Chat on WhatsApp</a></div></div></section>
</main><footer class="footer"><div class="wrap footergrid"><div><strong style="color:var(--blue2)">ChristieSpecial's Pharm & Med. Lab</strong><p>Pharmacy and medical laboratory services with patient-focused support.</p><small>© 2026 ChristieSpecial's Pharm & Med. Lab</small></div><div><strong>Explore</strong><p><a href="#pharmacy">Pharmacy</a></p><p><a href="#laboratory">Laboratory</a></p></div><div><strong>Contact</strong><p>07063184641</p><p>onalochristianah@gmail.com</p></div></div></footer>
<div class="modal" id="modal"><div class="modalbox"><button class="close" onclick="closeModal()">✕</button><div id="modalcontent"></div></div></div>
<script>
function filterProducts(q){document.querySelectorAll('.product').forEach(p=>p.style.display=p.dataset.name.includes(q.toLowerCase())?'block':'none')}
function demoSubmit(e,msg){e.preventDefault();alert(msg);e.target.reset()}
function openModal(type){let title=type==='login'?'Sign in':'Create customer account';document.getElementById('modalcontent').innerHTML=`<h2 style="color:var(--blue2)">${title}</h2><p class="muted">This is a visual preview. Use the connected Next.js application for live authentication.</p><form onsubmit="event.preventDefault();alert('Authentication is available in the connected Next.js application, not this standalone preview.');"><div class="field"><label>Email address</label><input type="email" required placeholder="you@example.com"></div>${type==='register'?'<div class="field"><label>Full name</label><input required placeholder="Your full name"></div>':''}<div class="field"><label>Password</label><input type="password" required placeholder="Password"></div><button class="btn pink" type="submit">${title}</button></form>`;document.getElementById('modal').classList.add('show')}
function closeModal(){document.getElementById('modal').classList.remove('show')}
document.getElementById('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
</script></body></html>
